# ─── Database ────────────────────────────────────────────────────────────────
# MySQL connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=mysql://root:your_password@localhost:3306/db_mfg_ticket_system

# ─── Session ─────────────────────────────────────────────────────────────────
# Long random string used to sign session cookies — change this in production
SESSION_SECRET=your_super_secret_key_here

# ─── CORS ────────────────────────────────────────────────────────────────────
# The exact origin of your React frontend (no trailing slash)
# Local dev:   http://localhost:5173
# Production:  https://your-app.vercel.app
ALLOWED_ORIGIN=http://localhost:5173

# ─── Cloudinary (file uploads) ───────────────────────────────────────────────
# Create a free account at https://cloudinary.com, then find these in the
# Cloudinary Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
